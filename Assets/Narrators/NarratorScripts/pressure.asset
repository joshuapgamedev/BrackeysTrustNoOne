      nextBlockID: 5
      taskUpdate:
        action: 0
        taskID: 
    nextBlockID: 
    taskUpdate:
      action: 0
      taskID: 
    randomResponse: 0
  - blockID: 3
    runCondition: 3
    allowRandomSelection: 0
    dialogue:
    - text: You did it! The door should now be op-
      audio: {fileID: 8300000, guid: 8405f365be476bd4fb399ded79708616, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Oh... Seems like the door <b>is</b> malfunctioning.
      audio: {fileID: 8300000, guid: 2802d2238864c2549a25981e76dabc1b, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Sorry, Player. It <b>definitely</b> won't open.
      audio: {fileID: 8300000, guid: 97a1d6e58a4192946b6e284b618c17b2, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: I suppose that is it, then.
      audio: {fileID: 0}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: No need to check, really.
      audio: {fileID: 0}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 0
    waitType: 0
    timeout: 0
    responses: []
