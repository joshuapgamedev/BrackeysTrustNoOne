  m_Script: {fileID: 11500000, guid: 8a4349e484843754d80e44abd04a44f7, type: 3}
  m_Name: pressure
  m_EditorClassIdentifier: 
  narratorID: PressurePlate
  blocks:
  - blockID: 1
    runCondition: 0
    allowRandomSelection: 0
    dialogue:
    - text: Now that you've pulled those levers, this will test your skills.
      audio: {fileID: 8300000, guid: 4e18d76957456a747a89511e92aad37f, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: I mean this will REALY test your skills
      audio: {fileID: 8300000, guid: 7f0d2c5d0df66b740b64bcf810a1bfce, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: You <b>won't</b> be able to leave this room until all plates are activated.
      audio: {fileID: 8300000, guid: af6182783c5c79e4ca132449aa85a272, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Go on. I'm watching.
      audio: {fileID: 8300000, guid: 28e165ba1bdbab9429cb92180c532f4a, type: 3}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 0
    waitType: 5
    timeout: 10
    responses:
    - eventType: 0
      dialogue: []
      nextBlockID: 2
      taskUpdate:
        action: 0
        taskID: 
    - eventType: 1
      dialogue:
      - text: Okay.. sure.
        audio: {fileID: 0}
        nextLineType: 0
        delayAfter: 0
        canBeInterrupted: 0
      nextBlockID: 2
      taskUpdate:
        action: 0
        taskID: 
    - eventType: 2
      dialogue: []
      nextBlockID: 4
      taskUpdate:
        action: 0
        taskID: 
    nextBlockID: 
    taskUpdate:
      action: 1
      taskID: pressurePuzzle
    randomResponse: 0
  - blockID: 2
    runCondition: 1
    allowRandomSelection: 0
    dialogue:
    - text: There we go. You know how it works.
      audio: {fileID: 8300000, guid: cc94f31801c70424bbf09879d4e1f3f0, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: One down, three more to go, Player.
      audio: {fileID: 8300000, guid: f356c2f06c2b82c45a01deb77b6159c4, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Shouldn't be that hard now, right?
      audio: {fileID: 8300000, guid: 03cf55264b6d61f4f8032c23bcd4cf26, type: 3}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 0
    waitType: 6
    timeout: 5
    responses:
    - eventType: 0
      dialogue: []
      nextBlockID: 3
      taskUpdate:
        action: 2
        taskID: pressurePuzzle
    - eventType: 1
      dialogue:
      - text: Okay.. sure.
        audio: {fileID: 0}
        nextLineType: 0
        delayAfter: 0
        canBeInterrupted: 0
      nextBlockID: 3
      taskUpdate:
        action: 2
        taskID: pressurePuzzle
    - eventType: 2
