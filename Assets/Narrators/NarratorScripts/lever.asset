    randomResponse: 0
  - blockID: 2
    runCondition: 1
    allowRandomSelection: 0
    dialogue:
    - text: "Hm. What's wrong?\r"
      audio: {fileID: 8300000, guid: b8cd05f8fa24196468e7cf9c89564d3d, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: 'It didn''t work?

'
      audio: {fileID: 8300000, guid: 916c3b4a22d8607488d099d9bf7a3527, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Come on.. All you need to do is pull <b>ALL</b> the levers
      audio: {fileID: 8300000, guid: 916fa1e3a37eb274c9af08db6194cd3f, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: "Maybe you should count the lever again, Player.\r"
      audio: {fileID: 8300000, guid: 0b9c95db54ee49f4c8ac7a34837bd73d, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: 'Fine. I''ll help.

'
      audio: {fileID: 8300000, guid: d44f66fffd97b3c43b098c03c5fc2637, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: One... Two... Three... Hmm..
      audio: {fileID: 8300000, guid: d49f7160310eea843802929af2b847bb, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: 'I never said there were only three of them.

'
      audio: {fileID: 8300000, guid: 424422c70620116439b5d00ed98ef120, type: 3}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 0
    waitType: 4
    timeout: 10
