  blocks:
  - blockID: 1
    runCondition: 0
    allowRandomSelection: 0
    dialogue:
    - text: 'Here is your first challenge to proceed to the next puzzle room.

'
      audio: {fileID: 8300000, guid: 450ac5f3c0ef99f489820693ac89c393, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: 'Very simple I assure you.

'
      audio: {fileID: 8300000, guid: 4ad53559598ee4b42b74d799bd709195, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: "Come on all you need to do it find <b>ALL</b> the levers \r\n"
      audio: {fileID: 8300000, guid: 916fa1e3a37eb274c9af08db6194cd3f, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 1
    - text: 'and <b>activate</b> them to proceed to the next puzzle room.

'
      audio: {fileID: 8300000, guid: 0095fb1125efa6b4c8ae5f81de9f3e4c, type: 3}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 1
    - text: 'Go ahead and give it a try! '
      audio: {fileID: 8300000, guid: b89b08dc41a908743a40b85d0d814a59, type: 3}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 1
    waitType: 3
