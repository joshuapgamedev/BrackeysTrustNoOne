    dialogue:
    - text: Now that you've pulled those levers,
      audio: {fileID: 0}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: this will test your skills, Player.
      audio: {fileID: 0}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: You <b>won't</b> be able to leave this room until all the red plates
        are activated.
      audio: {fileID: 0}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Go on. I'm watching.
