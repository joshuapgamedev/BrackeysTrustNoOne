      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: One down, three more to go, Player.
      audio: {fileID: 0}
      nextLineType: 1
      delayAfter: 1
      canBeInterrupted: 0
    - text: Shouldn't be that hard now, right?
      audio: {fileID: 0}
      nextLineType: 0
      delayAfter: 0
      canBeInterrupted: 0
    waitType: 6
