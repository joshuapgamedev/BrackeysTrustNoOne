        delayAfter: 0
        canBeInterrupted: 0
    - eventType: 1
      nextSequenceID: 2
      dialogue:
      - text: Good job there!
        audio: {fileID: 0}
        delayAfter: 0
        canBeInterrupted: 0
    - eventType: 2
      nextSequenceID: 3
      dialogue:
      - text: Please...
        audio: {fileID: 0}
        delayAfter: 0
        canBeInterrupted: 0
    - eventType: 3
      nextSequenceID: 4
      dialogue:
      - text: Okay.. No harsh feeling..
        audio: {fileID: 0}
        delayAfter: 0
        canBeInterrupted: 0
  - sequenceID: 2
