        delayAfter: 0
        canBeInterrupted: 0
    - eventType: 2
      nextSequenceID: 3
      dialogue:
      - text: Um... hello? You there? Do you need me to go slower?
        audio: {fileID: 0}
        delayAfter: 0
        canBeInterrupted: 0
    - eventType: 3
      nextSequenceID: 4
      dialogue:
      - text: Oh.. okay then... I won't take this personally.. probably.
        audio: {fileID: 0}
        delayAfter: 0
        canBeInterrupted: 0
  - sequenceID: 3
    dialogue:
    - text: Press... <b>S..P..A..C..E..</b> to.. jump..
